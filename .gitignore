.env
venv/
__pycache__/
*.pyc
audit.sqlite
auth.log

# Self-signed TLS cert/key generated by tls.py when SERVE_TLS=true (see
# gunicorn.conf.py) - a fresh, install-specific keypair, never meant to
# be checked in. Default names when TLS_CERT_FILE/TLS_KEY_FILE aren't
# set; a custom path elsewhere isn't covered by this and shouldn't be
# placed inside the repo in the first place.
tls_cert.pem
tls_key.pem

# Working dev-notes log - detailed design rationale kept local only.
# See CHANGELOG.md for the public-facing, per-change history instead.
NOTES.md

# Anything else a particular machine keeps beside the checkout and must
# not be committed belongs in .git/info/exclude, which is per-clone and
# is not published. A name listed here is a name this repository tells
# the world about - the wrong trade for a file only one machine has.
# Claude Code local settings - machine-specific paths, never shared.
.claude/
