# Copy this to .env and fill in real values. .env is gitignored - never commit it.

# --- TAK Server Postgres connection ------------------------------------
# Seeds app_settings on first run only; once an admin saves connection
# settings via /admin, those take over and these are no longer read.
# (The admin page itself also has these same defaults built in for
# DB_PORT/DB_NAME, so leaving them blank there works too - filling them in
# here just matters for the very first startup, before anyone has logged
# in to save anything.)
#
# DB_HOST: depends on HOW this app is running, not just where Postgres is.
#   Bare metal, same machine as TAK Server (all-in-one): 127.0.0.1 (or
#   localhost) is correct. Docker, same machine as TAK Server: 127.0.0.1
#   is NOT correct - that's the container's own loopback, not the host's.
#   Run ./connect-database.sh instead, which finds the real address (the
#   Docker bridge gateway) automatically and configures everything else
#   needed to reach it (firewall, Postgres's listen_addresses/pg_hba.conf).
#   Separate server (split/HA), either way: put that server's address
#   here - no safe default, deliberately left blank.
# DB_PORT: TAK Server's standard Postgres port. 5432 if blank/unset.
# DB_NAME: TAK Server's standard database name is "cot" - used if blank/unset.
# DB_USER / DB_PASSWORD: use a dedicated, least-privilege read-only
#   account for this tool, not TAK Server's own internal database user.
#   No default on purpose.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Auth ---------------------------------------------------------------
# 'authentik' - this deployment sits behind a reverse proxy (e.g.
#   infra-TAK's Caddy) doing Authentik forward-auth, which gates access
#   before Flask ever sees the request. No local login is used; identity
#   comes from the X-authentik-username header that proxy sets.
# 'local' - standalone deployment, no Authentik in front. This app's own
#   login form + session is the only gate.
# Required - the app refuses to start if this is missing or invalid.
AUTH_MODE=local

# Required in both modes. Signs the login session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. If set, this username is (re-)promoted to admin on every
# startup whenever the users table currently has zero admins - the way to
# create the very first admin, and a standing recovery path if every admin
# account is ever deleted.
#
# In AUTH_MODE=authentik specifically, this MUST be a real username that
# already exists in Authentik - this app has no login page of its own in
# that mode, so the only way anyone becomes the first admin is by passing
# the Authentik challenge AS this exact username. A placeholder like
# "admin" (the safe default in local mode) would silently lock everyone
# out there instead: the app starts fine, but nobody can ever sign in as
# an admin. setup.sh asks for this explicitly when AUTH_MODE=authentik.
BOOTSTRAP_ADMIN_USERNAME=
# Leave blank (the common case, especially a fresh container's first boot)
# to have a secure random password generated and printed to stdout ONCE,
# the moment the first admin account is created - check your server/
# container logs right after first startup. Set this explicitly only for
# a scripted/automated deployment that needs a known password. Only
# matters in AUTH_MODE=local (authentik mode never checks a password here).
BOOTSTRAP_ADMIN_PASSWORD=

# Builds the URL shown in the one-time bootstrap-password message (see
# bootstrap_admin() in app.py), and is the real bind port everywhere that
# matters: docker-compose.yml's HOST-side port mapping, gunicorn.conf.py's
# own bind (bare metal only - inside a container this is always a fixed
# internal 8080, since PORT there only controls the HOST side of Docker's
# port mapping, not gunicorn's own bind - see gunicorn.conf.py), and
# tak-extract.service, all reading this same value. Change it here to run
# a second instance on this same host (Docker: alongside another
# container already using 8080; bare metal: a second systemd unit) - no
# docker-compose.yml or unit-file edit needed either way.
# NOT read by the dev server (`python app.py`), which always binds 5000 -
# this file is copied to .env as part of that quick start, so reading it
# there would move the dev server off the port the README tells you to
# open. The startup banner knows which of the two is running and prints
# the port that one actually binds.
PORT=8080

# How long (seconds) gunicorn lets a single request run before killing the
# worker handling it - the default (300 = 5 minutes) is generous for
# building a full evidence package (potentially large amounts of position
# data, several files, hashing/zipping) against a real production TAK
# Server, not just typical request/response work. gunicorn's own default
# is 30s, which is too short for this - past it, the connection just
# drops and a browser reports a generic "Failed to fetch" with no useful
# error. Raise this further if exports against a genuinely large dataset
# still time out; check `docker compose logs web` for "WORKER TIMEOUT" to
# confirm that's actually what's happening before assuming it is.
GUNICORN_TIMEOUT=300

# Set to false ONLY for local http:// development (python app.py on
# localhost). Must stay true (the default) any time this app is reachable
# over anything other than localhost HTTPS - a browser silently refuses
# to send a Secure-flagged cookie back over plain http://, so leaving this
# true during local dev breaks login entirely (it'll look like it worked,
# then the very next request will look logged-out).
SESSION_COOKIE_SECURE=true

# --- Direct TLS (optional - see README.md) ---------------------------------
# Off by default: without it, this app is loopback-only everywhere and a
# reverse proxy is expected to provide any real network exposure AND its
# own TLS - the common setup (infra-TAK's Caddy, standalone nginx, etc.),
# and the one every other default in this file already assumes.
#
# Set to true only if this app should terminate its own HTTPS directly,
# with no reverse proxy in front at all. It generates (once - see tls.py)
# a self-signed certificate; every browser that connects will show a
# security warning the first time, which is expected - click through it
# ("Proceed"/"Accept the Risk") once per device. Needs `openssl` on PATH
# (already installed in the Docker image; almost always already present
# on a real Linux install, unlike a minimal container).
#
# Also requires BIND_ADDR=0.0.0.0 below under Docker specifically -
# SERVE_TLS alone doesn't change docker-compose.yml's own host-side port
# mapping, so leaving BIND_ADDR at its loopback-only default would
# generate and serve a cert nobody outside this host could ever reach.
SERVE_TLS=false

# Where the generated cert/key pair live. Blank (the default) puts them
# alongside AUDIT_DB, so whatever already persists that (Docker's ./data
# volume) persists these too with no extra configuration - only set these
# if you want a specific existing cert/key pair used instead of a
# generated one.
TLS_CERT_FILE=
TLS_KEY_FILE=

# The address or hostname the self-signed certificate is issued for, and
# the one printed in the startup "Log in at:" line. Only matters with
# SERVE_TLS=true. On bare metal this is detected automatically and can stay
# blank. Under Docker it can't be: from inside the container the only
# address visible is the container's own private one (172.x), so the cert
# would be issued for a name nobody ever types and every browser would
# show a NAME-MISMATCH error on top of the expected self-signed warning.
# setup.sh fills this in from the host when it turns SERVE_TLS on; set it
# by hand (an IP, or a DNS name people will actually use) if you edit .env
# yourself. localhost/127.0.0.1 are always covered as well.
TLS_CERT_HOST=

# Docker only - see the note atop docker-compose.yml. Leave at the
# default (127.0.0.1, loopback-only) for a reverse-proxy-fronted setup;
# set to 0.0.0.0 (or a specific host IP) together with SERVE_TLS=true
# above for this app to be reached directly. Has no effect on bare metal
# (SERVE_TLS alone decides gunicorn's own bind there - see
# gunicorn.conf.py).
#
# Do NOT set this to 0.0.0.0 while leaving SERVE_TLS=false. With SERVE_TLS
# off the app assumes a reverse proxy is the only thing that can reach it
# and trusts the X-Forwarded-For header that proxy sets (see ProxyFix in
# app.py). Exposed directly, anyone on the network can send that header
# themselves - forging the source IP written to every audit-log row and
# to auth.log, which is exactly what fail2ban bans on. If your reverse
# proxy genuinely runs on a different host, put it and this container on
# a private network the proxy alone can reach, rather than 0.0.0.0.
BIND_ADDR=127.0.0.1

# --- Re-check folder on the TAK Server -------------------------------------
# Written by connect-database.sh when it has created (or found) the folder
# the Export page's re-check line writes into, /var/lib/takextract/recheck,
# and the takextract group. The System page shows it as "set up on ...".
# Blank means the script has not recorded doing so on this host; the
# System page then shows the one-time setup line instead. Informational
# only - the app never reads the folder itself.
RECHECK_FOLDER_SETUP=

# --- Audit log ------------------------------------------------------------
# Where the audit log / users / app_settings sqlite database lives.
# Docker: a path inside the container, on the ./data bind mount.
# Side-by-side: setup.sh points this at /opt/tak-extract/data/audit.sqlite,
# the one directory the service account is allowed to write.
AUDIT_DB=audit.sqlite

# Where this clone sits ON THE HOST. Written by setup.sh; only a Docker
# install needs it. Inside a container the app only ever sees /app, so it
# cannot work out where to tell you to run `git pull` - without this the
# System page's update command says what to run but not where, and running
# it in the wrong directory fails with "not a git repository". Blank is
# safe: the page then prints a placeholder path and says to replace it.
HOST_INSTALL_DIR=

# --- Install path ---------------------------------------------------------
# Which shape this install is: "docker" (in a container, reaching Postgres
# across the Docker bridge) or "baremetal" (installed straight onto the TAK
# Server's own machine, reaching Postgres over loopback). setup.sh asks once
# and writes the answer here; connect-database.sh reads it to know whether a
# pg_hba.conf line and a firewall rule are needed at all - a side-by-side
# install needs neither. Blank means neither script has run yet.
INSTALL_MODE=

# --- Map and privacy ------------------------------------------------------
# What the maps on the Export and Verify pages are allowed to contact.
# Site-wide, not per-account. Both default to "true", which is how every
# install has worked up to now; the System page's "Map and privacy" panel
# writes the same two values into app_settings, which WINS over whatever is
# set here. These lines are a first-run seed - set them to "false" if an
# install must never reach OpenStreetMap even before an admin has logged in.
#
# MAP_SEARCH=false removes the address-search box in the map's corner.
# Whatever is typed into it goes to OpenStreetMap's public Nominatim
# service, so a case address typed there is a disclosure to a third party.
#
# MAP_TILES=false leaves the map blank. No case data is sent either way, but
# the pattern of tile requests describes which area is being looked at. You
# can still draw an area and read its coordinates with tiles off; there is
# just no geography under it.
MAP_SEARCH=true
MAP_TILES=true
